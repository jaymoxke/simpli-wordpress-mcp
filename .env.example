# Public MCP/custom-domain origin, without a trailing slash.
PUBLIC_BASE_URL=https://mcp.example.com

# Exact canonical WordPress origin. Do not use an alias that redirects to another
# hostname: the gateway rejects redirects and signed requests bind this origin.
WORDPRESS_URL=https://www.example.com

# Hosting-edge compatibility signal only. Machine identity/security comes from
# the signed transport, not from User-Agent. Keep this browser-compatible if the
# WordPress hosting edge rejects generic server/AI client signatures.
WORDPRESS_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/150.0.0.0 Safari/537.36

# WordPress backend authentication rollout:
#   basic  = legacy WordPress Application Password only
#   dual   = Basic + short-lived Ed25519 request attestation (migration mode)
#   signed = Ed25519 request attestation only (target after verifier acceptance)
WORDPRESS_AUTH_MODE=dual
WORDPRESS_USERNAME=mcp-gateway
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
WORDPRESS_SIGNING_KEY_ID=simpli-mcp-gateway-2026-r1
# Absolute path to an Ed25519 PKCS#8 private key mounted from the deployment secret store.
WORDPRESS_SIGNING_PRIVATE_KEY_PATH=/run/secrets/simpli-mcp-wordpress-ed25519.pem
WORDPRESS_SIGNING_TTL_SECONDS=60

# OAuth 2.1 owner authorization and durable state.
# OAUTH_STATE_DB_PATH must be an absolute, persistent filesystem path in production.
OAUTH_ADMIN_PASSWORD=replace-with-a-strong-owner-login-password
OAUTH_STATE_DB_PATH=/var/lib/simpli-mcp/oauth.sqlite

# Optional static bearer token for bounded machine testing/integration.
# Leave unset in the public production deployment unless separately approved.
MCP_STATIC_TOKEN=

# Optional dedicated WhatsApp read-only MCP token. Must differ from MCP_STATIC_TOKEN.
WHATSAPP_MCP_TOKEN=

# Runtime controls.
PORT=3000
ABILITY_CACHE_TTL_SECONDS=300
WORDPRESS_TIMEOUT_MS=65000
MAX_TOOL_OUTPUT_BYTES=262144
OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
LOG_LEVEL=info
