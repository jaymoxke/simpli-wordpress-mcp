# Public Railway/custom-domain origin, without a trailing slash.
PUBLIC_BASE_URL=https://mcp.example.com

# Existing WordPress site with WordPress 6.9+ Abilities API and Novamira.
WORDPRESS_URL=https://www.example.com
WORDPRESS_USERNAME=mcp-gateway
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# OAuth 2.1 single-owner authorization. Generate both with: openssl rand -base64 48
OAUTH_SIGNING_SECRET=replace-with-at-least-32-random-characters
OAUTH_ADMIN_PASSWORD=replace-with-a-strong-owner-login-password

# Optional static bearer token for MCP Inspector/Responses API testing.
# Do not use this as the only authentication method for a public ChatGPT plugin.
MCP_STATIC_TOKEN=

# Runtime controls.
PORT=3000
ABILITY_CACHE_TTL_SECONDS=300
WORDPRESS_TIMEOUT_MS=65000
MAX_TOOL_OUTPUT_BYTES=262144
OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
LOG_LEVEL=info
